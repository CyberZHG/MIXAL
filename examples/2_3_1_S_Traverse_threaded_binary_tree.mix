LLINKT  EQU   0:2
RLINKT  EQU   0:2
S0      ENT5  HEAD            S0. Initialize. Set P ← HEAD.
        JMP   2F
S3      JMP   VISIT           S3. Visit P.
S1      LD5N  1,5(RLINKT)     S1. RLINK(P) a thread?
        J5NN  1F              Jump if RTAG(P) = 1.
        ENN6  0,5             Otherwise set Q ← RLINK(P).
S2      ENT5  0,6             S2. Search to left. Set P ← Q.
2H      LD6   0,5(LLINKT)     Q ← LLINKT(P).
        J6P   S2              If LTAG(P) = 0, repeat.
1H      ENT6  -HEAD,5
        J6NZ  S3              Visit unless P = HEAD.
        HLT
VISIT   STJ   9F
        LDA   0,5(3:5)
        STA   OUT,4(1:1)
        INC4  1
9H      JMP   *
        ORIG  1000
HEAD    CON   NA(LLINKT)
        CON   HEAD(RLINKT)
NA      CON   NB(LLINKT),1(3:5)
        CON   NC(RLINKT)
NB      CON   ND(LLINKT),2(3:5)
        CON   -NA(RLINKT)
NC      CON   NE(LLINKT),3(3:5)
        CON   NF(RLINKT)
ND      CON   -HEAD(LLINKT),4(3:5)
        CON   -NB(RLINKT)
NE      CON   -NA(LLINKT),5(3:5)
        CON   NG(RLINKT)
NF      CON   NH(LLINKT),6(3:5)
        CON   NJ(RLINKT)
NG      CON   -NE(LLINKT),7(3:5)
        CON   -NC(RLINKT)
NH      CON   -NC(LLINKT),8(3:5)
        CON   -NF(RLINKT)
NJ      CON   -NF(LLINKT),11(3:5)
        CON   -HEAD(RLINKT)
OUT     ORIG  *+10
        END   S0
