LLINK  EQU  1:2
RLINK  EQU  1:2
MAX    EQU  100
T1     LD5  HEAD(LLINK)    T1. Initialize. Set P ← T.
T2A    J5Z  DONE           Stop if P = Λ.
       ENT6 0
T3     DEC6 MAX            T3. Stack ⇐ P.
       J6NN OVERFLOW       Has that stack reached capacity?
       INC6 MAX+1          If not, increase the stack pointer.
       ST5  A,6            Store P in the stack.
       LD5  0,5(LLINK)     P ← LLINK(P).
T2B    J5NZ T3             To T3 if P ≠ Λ.
T4     LD5  A,6            T4. P ⇐ Stack.
       DEC6 1              Decrease the stack pointer.
T5     JMP  VISIT          T5. Visit P.
       LD5  1,5(RLINK)     P ← RLINK(P).
T2C    J5NZ T3             T2. P = Λ?
       J6NZ T4             Test if the stack is empty.
DONE   HLT
OVERFLOW HLT 999
VISIT  STJ  9F
       LDA  0,5(3:5)
       STA  OUT,4(1:1)
       INC4 1
9H     JMP  *
       ORIG 1000
HEAD   CON  NA(LLINK)
       CON  0
NA     CON  NB(LLINK),1(3:5)
       CON  NC(RLINK)
NB     CON  ND(LLINK),2(3:5)
       CON  0
NC     CON  NE(LLINK),3(3:5)
       CON  NF(RLINK)
ND     CON  4(3:5)
       CON  0
NE     CON  5(3:5)
       CON  NG(RLINK)
NF     CON  NH(LLINK),6(3:5)
       CON  NJ(RLINK)
NG     CON  7(3:5)
       CON  0
NH     CON  8(3:5)
       CON  0
NJ     CON  11(3:5)
       CON  0
OUT    ORIG *+10
A      ORIG *+MAX+1
       END  T1
