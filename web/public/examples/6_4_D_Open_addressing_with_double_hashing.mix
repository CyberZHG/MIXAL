N        EQU   16
M        EQU   19
KEYS     EQU   1000
TABLE    EQU   1100
VACANCIES EQU  1050
K        EQU   1051
         ORIG  3000
BEGIN    ENT6  1
LOOP     LDA   KEYS,6
         STA   K
START    LDX   K
         ENTA  0
         DIV   =M=
         STX   *+1(0:2)
         ENT1  *
         LDX   TABLE,1
         CMPX  K
         JE    SUCCESS
         JXZ   4F
         SRAX  5
         DIV   =M-2=
         STX   *+1(0:2)
         ENT2  *
         LDA   K
3H       DEC1  1,2
         J1NN  *+2
         INC1  M
         CMPA  TABLE,1
         JE    SUCCESS
         LDX   TABLE,1
         JXNZ  3B
4H       LDX   VACANCIES
         JXZ   OVERFLOW
         DECX  1
         STX   VACANCIES
         LDA   K
         STA   TABLE,1
SUCCESS  INC6  1
         CMP6  =N=
         JLE   LOOP
         HLT
OVERFLOW HLT   1
         END   BEGIN
